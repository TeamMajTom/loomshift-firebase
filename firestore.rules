rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can read and write only their own notes.
    match /notes/{noteId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // Each signed-in person can read and write only their own profile.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Any signed-in person can read the public question list, but only the
    // author can create, edit, or delete their own question.
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // Answers are readable by any signed-in person; only their author can
      // create, edit, or delete them.
      match /answers/{answerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

        // One upvote per person (the doc id is the voter's uid), never on their own answer.
        match /votes/{voterId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null
            && voterId == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && get(/databases/$(database)/documents/questions/$(questionId)/answers/$(answerId)).data.uid != request.auth.uid;
          allow delete: if request.auth != null && voterId == request.auth.uid;
        }
      }

      // One upvote per person (the doc id is the voter's uid), never on their own question.
      match /votes/{voterId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && voterId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/questions/$(questionId)).data.uid != request.auth.uid;
        allow delete: if request.auth != null && voterId == request.auth.uid;
      }
    }

    // Everything else is closed. Open a path here on purpose, never by default.
  }
}
